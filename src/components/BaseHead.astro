---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { BRAND_COLOR } from '../lib/brand';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	noindex?: boolean;
	/**
	 * Use `title` verbatim instead of appending "| SITE_TITLE".
	 *
	 * Only the homepage should set this. Every other page wants the suffix so
	 * a tab or a SERP row carries the business name, but the homepage needs
	 * its full ~55 characters for the name *and* the positioning, and
	 * "West Oaks Design | … | West Oaks Design" is what the default produces.
	 */
	fullTitle?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
	title,
	description,
	image = '/images/og-default.png',
	noindex,
	fullTitle,
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} | ${SITE_TITLE}`;
const ogImage = new URL(image, Astro.site).toString();
---

<meta charset="utf-8" />

<Analytics />
<SpeedInsights />

<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!--
	Aspekta, self-hosted. One 30KB variable file covers weights 100-900, which
	is smaller than the three static DM Sans cuts it replaced and costs no
	third-party connection — so there's no preconnect/DNS round trip before
	text can paint, and no Google Fonts request in the privacy story.

	Preloaded because the @font-face lives in global.css: without this the
	browser can't discover the file until the stylesheet has parsed.
	Licence: OFL 1.1, shipped alongside at /fonts/Aspekta-OFL-LICENSE.txt.
-->
<link rel="preload" href="/fonts/AspektaVF.woff2" as="font" type="font/woff2" crossorigin />

<link rel="canonical" href={canonicalURL} />

<!--
	SEO / AEO baseline — every page must pass a unique title + description
	as props. Titles should read naturally for both search engines and
	answer engines (how people actually ask, not keyword-stuffed).
-->
<title>{pageTitle}</title>
<meta name="description" content={description} />

<!--
	Explicitly allow the large text/image previews that answer engines and
	social cards build from. Without it, some crawlers default to a truncated
	snippet, which is the opposite of what an AEO-focused build wants.
-->
{!noindex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

<!-- Tints the browser chrome on mobile to the brand colour. A meta tag
     can't read a custom property, so the value is parsed out of tokens.css
     at build time rather than pasted here — see src/lib/brand.ts. -->
<meta name="theme-color" content={BRAND_COLOR} />

<meta property="og:type" content="website" />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE_TITLE} — ${SITE_DESCRIPTION}`} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
<meta property="twitter:image:alt" content={`${SITE_TITLE} — ${SITE_DESCRIPTION}`} />
