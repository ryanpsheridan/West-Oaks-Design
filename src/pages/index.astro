---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SERVICES } from '../data/services';
import { breadcrumbSchema, serviceSchema } from '../lib/schema';
import {
	SITE_PHONE,
	SITE_EMAIL,
	SITE_ADDRESS,
	SERVICE_AREA,
	SERVICE_AREA_LABEL,
} from '../consts';

// ---------------------------------------------------------------------------
// PAGE CONTENT — everything a client edit touches lives in this block. The
// markup below reads from it, so copy changes never mean hunting through JSX.
//
// Section order: hero → trust → services → approach → work → contact. The
// services themselves come from src/data/services.ts, shared with /services/
// and the structured data, so they can't drift apart.
//
// ⚠️ FIRST DRAFT. The voice is drawn from the three reference sites the
// client gave (Lake|Flato, Escobedo Group, LandWest): plain, specific,
// regionally grounded, and allergic to "transform your outdoor oasis".
//
// IMPORTANT: this is a brand new business with no completed projects and no
// clients yet. Nothing on this page may imply otherwise — no testimonials, no
// project counts, no "trusted by", no past-work gallery presented as
// past work. The page has to earn trust on expertise and clarity instead,
// which is why the approach section carries so much of the weight. Do not
// reintroduce social proof until there is some.
// ---------------------------------------------------------------------------

const hero = {
	headline: 'West Oaks Design landscaping services',
	sub: 'We plan, build and look after residential landscapes across Austin and the Hill Country: native planting, limestone hardscape, efficient irrigation, outdoor lighting, and the tree care that keeps it all standing. Designed around the site you actually have.',
	primaryCta: { label: 'Start your project', href: '/contact/#project' },
	secondaryCta: { label: 'What we do', href: '/services/' },
	image: {
		src: '/images/gallery/oak-motte-meadow.svg',
		alt: 'Photo placeholder — a motte of live oaks standing over an open meadow, with low hills behind',
	},
};

// Three proof points, not four — a fourth starts reading as a list rather
// than a set of claims someone stands behind.
//
// With no completed projects to point at, these carry more weight than they
// normally would, so they have to be things that are true on day one:
// credentials, how the business is structured, what it commits to. Not
// experience it does not have yet.
//
// TODO: the first two are factual claims. Confirm each with the client and
// add the real licence numbers, or delete the signal. A credential that turns
// out to be wrong does more damage than having none listed.
const trustSignals = [
	{
		icon: 'award',
		label: 'ISA Certified Arborist',
		detail: 'TODO: confirm, and add the certification number.',
	},
	{
		icon: 'droplet',
		label: 'Licensed Texas irrigator',
		detail: 'TODO: confirm, and add the LI number — Texas requires it on irrigation work.',
	},
	{
		icon: 'ruler',
		label: 'Design and build under one roof',
		detail: 'The people who draw it are the people who build it, so nothing is lost in the handoff.',
	},
];

const servicesSection = {
	eyebrow: 'Services',
	heading: 'What we do',
	lead: 'Six lines of work that hold together: a plan first, then the ground, the water, the structures and the trees, and the care that keeps them going afterwards.',
	action: { label: 'All services', href: '/services/' },
};

const benefitsSection = {
	eyebrow: 'Our approach',
	heading: 'Built for this place, not in spite of it',
	lead: 'Most landscapes here fail for the same few reasons: the wrong plants, too much water, too little shade, and nobody looking after the trees. We design against all four from the first sketch.',
};

const benefits = [
	{
		title: 'Native and adapted planting',
		description:
			'Plants chosen for Central Texas soil, heat and rainfall, so the landscape survives a dry August without an irrigation system carrying it. Less water, less replacement, less work for you.',
	},
	{
		title: 'Biophilic by default',
		description:
			'Shade where you sit, water you can hear, a view from every window that has something living in it. Designing for how people actually feel outdoors is the whole point, not a finish applied at the end.',
	},
	{
		title: 'The trees come first',
		description:
			'A mature live oak takes eighty years and cannot be bought. We protect root zones before a machine arrives on site, and time every cut around the oak wilt calendar.',
	},
	{
		title: 'Built to be looked after',
		description:
			'Every project leaves with a written plan for keeping it: what gets pruned when, what the water budget is, what needs replacing in year five. Whether we do that work or you do, you have it.',
	},
];

// Deliberately framed as what the work *is*, not as projects already
// delivered. There are none yet, and three photos under a "recent work"
// heading is a claim whether or not the words say so.
const workSection = {
	eyebrow: 'The work',
	heading: 'What we build',
	lead: 'Three of the things we are asked for most, and what we care about in each.',
	action: { label: 'See the full range', href: '/gallery/' },
};

const galleryPreview = [
	{
		src: '/images/gallery/limestone-terrace.svg',
		alt: 'Photo placeholder — a limestone terrace stepping down toward a lawn beneath two oaks',
		caption: 'Limestone terraces, cut and set to sit level on a slope',
	},
	{
		src: '/images/gallery/pergola-shade-structure.svg',
		alt: 'Photo placeholder — a cedar pergola with evenly spaced rafters over a paved seating area',
		caption: 'Cedar shade structures, oriented for the four o\'clock sun',
	},
	{
		src: '/images/gallery/native-planting-beds.svg',
		alt: 'Photo placeholder — massed native planting flanking a stone path running away from the viewer',
		caption: 'Native planting chosen to hold up through a dry August',
	},
];

const contactSection = {
	eyebrow: 'Get started',
	heading: 'Tell us what you are planning',
	lead: 'Everything starts with one form: what the property is, what you want from it, roughly when, and roughly what budget it sits in. It takes a few minutes and commits you to nothing.',
	cta: { label: 'Start your project', href: '/contact/#project' },
};

const trail = [];
const schema = [
	breadcrumbSchema(Astro.site, trail),
	// The homepage is where the full service catalogue is declared. Each entry
	// points back at the business node by @id rather than restating it.
	...SERVICES.map((service) =>
		serviceSchema(Astro.site, {
			title: service.title,
			description: service.long,
			slug: service.slug,
		})
	),
];
---

<BaseLayout
	title="West Oaks Design | Hill Country Landscape Design & Build"
	fullTitle
	description="Landscape design-build in Austin and the Texas Hill Country: native planting, limestone patios, irrigation, lighting and expert tree care."
	schema={schema}
>
	<section class="section-loose">
		<div class="container">
			<div class="split hero" style="--split-cols: 1.3fr 1fr;">
				<div class="hero-copy">
					<h1 class="display">{hero.headline}</h1>
					<p class="lead hero-sub">{hero.sub}</p>
					<div class="hero-actions">
						<a href={hero.primaryCta.href} class="btn btn-brand btn-lg btn-arrow">{hero.primaryCta.label}</a>
						<a href={hero.secondaryCta.href} class="btn btn-secondary btn-lg">{hero.secondaryCta.label}</a>
					</div>
					<p class="hero-area text-tertiary">
						Serving {SERVICE_AREA.slice(0, -1).join(', ')} and {SERVICE_AREA.at(-1)}.
					</p>
				</div>
				<div class="media-frame hero-media" style="--media-ratio: 5 / 4;">
					<img src={hero.image.src} alt={hero.image.alt} fetchpriority="high" width="1600" height="1200" />
				</div>
			</div>
		</div>
	</section>

	<section class="trust-bar" aria-label="Credentials">
		<div class="container">
			<ul class="trust-list">
				{trustSignals.map((signal) => (
					<li class="trust-item">
						<span class="trust-icon"><Icon name={signal.icon} size={20} /></span>
						<span class="trust-text">
							<span class="trust-label">{signal.label}</span>
							<span class="trust-detail">{signal.detail}</span>
						</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-header">
				<div class="section-header-text">
					<p class="eyebrow">{servicesSection.eyebrow}</p>
					<h2>{servicesSection.heading}</h2>
					<p class="lead">{servicesSection.lead}</p>
				</div>
				<a href={servicesSection.action.href} class="btn btn-primary btn-arrow">{servicesSection.action.label}</a>
			</div>
			<ul class="grid-auto service-grid">
				{SERVICES.map((service) => (
					<li class="card card-tint card-interactive">
						<span class="service-icon"><Icon name={service.icon} size={22} /></span>
						{/*
							The whole card is the target, via a stretched link on the
							heading — one link per card rather than a card-wide <a>
							wrapping a heading, so the accessible name of the link is the
							service name and nothing else.
						*/}
						<h3><a href={`/services/#${service.slug}`} class="service-link">{service.title}</a></h3>
						<p class="text-secondary">{service.short}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section-loose section-brand">
		<div class="container">
			<div class="section-header section-header-center">
				<div class="section-header-text">
					<p class="eyebrow">{benefitsSection.eyebrow}</p>
					<h2>{benefitsSection.heading}</h2>
					<p class="lead">{benefitsSection.lead}</p>
				</div>
			</div>
			<ul class="grid-auto benefit-grid">
				{benefits.map((benefit) => (
					<li class="topline">
						<h3>{benefit.title}</h3>
						<p class="text-secondary">{benefit.description}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-header">
				<div class="section-header-text">
					<p class="eyebrow">{workSection.eyebrow}</p>
					<h2>{workSection.heading}</h2>
					<p class="lead">{workSection.lead}</p>
				</div>
				<a href={workSection.action.href} class="btn btn-primary btn-arrow">{workSection.action.label}</a>
			</div>
			<ul class="work-grid">
				{galleryPreview.map((image) => (
					<li>
						<figure class="work-figure">
							<a href="/gallery/" class="work-item media-frame">
								<img src={image.src} alt={image.alt} loading="lazy" width="1600" height="1200" />
							</a>
							<figcaption class="work-caption text-tertiary">{image.caption}</figcaption>
						</figure>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section section-sunken">
		<div class="container">
			<div class="split split-top" style="--split-cols: 1fr 1fr;">
				<div class="closing-copy">
					<p class="eyebrow">{contactSection.eyebrow}</p>
					<h2>{contactSection.heading}</h2>
					<p class="lead">{contactSection.lead}</p>
					<a href={contactSection.cta.href} class="btn btn-brand btn-lg btn-arrow closing-cta">
						{contactSection.cta.label}
					</a>
					<p class="text-secondary closing-alt">
						Would rather read first? Here is <a href="/process/">how a project runs</a>,
						and <a href="/services/">what each service covers</a>.
					</p>
				</div>

				{/*
					The form itself lives on /contact/ and nowhere else. A second,
					shorter form here would split enquiries across two shapes of
					data in the same inbox, and the whole point of the long form is
					that one pass collects enough to actually price the job.
				*/}
				<div class="card closing-card">
					<h3 class="closing-card-heading">Or reach us directly</h3>
					<p class="contact-details">
						<a href={`tel:${SITE_PHONE.replace(/[^\d+]/g, '')}`}>{SITE_PHONE}</a>
						<br />
						<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
						{SITE_ADDRESS && (
							<>
								<br />
								{SITE_ADDRESS}
							</>
						)}
					</p>
					<p class="text-tertiary contact-area">{SERVICE_AREA_LABEL}</p>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	/* Hero — asymmetric split so the headline column stays inside a readable
	   measure while the media carries the remaining width. Stacks to a single
	   column below the split breakpoint, text first. */
	.hero-copy {
		max-width: var(--measure);
	}

	.hero-sub {
		margin-bottom: var(--space-6);
	}

	.hero-actions {
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
	}

	/* The service-area line sits under the buttons rather than in the
	   headline: it's the answer to "do you come to me?", which matters a lot
	   to the few people asking it and not at all to the rest. */
	.hero-area {
		font-size: var(--text-small);
		margin: var(--space-5) 0 0;
	}

	.hero-media {
		box-shadow: var(--shadow-lg);
	}

	/* Trust bar — proof points between the hero and the first real section,
	   full-bleed so the hairlines run the whole width. */
	.trust-bar {
		padding-block: var(--space-6);
		border-block: 1px solid var(--border-hairline);
	}

	.trust-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-5);
	}

	.trust-item {
		display: flex;
		align-items: flex-start;
		gap: var(--space-3);
	}

	.trust-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: var(--radius-md);
		background: var(--surface-fill);
		color: var(--color-text);
	}

	.trust-text {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		min-width: 0;
	}

	.trust-label {
		font-size: var(--text-body);
		font-weight: var(--weight-medium);
		line-height: var(--leading-snug);
		color: var(--color-text);
	}

	.trust-detail {
		font-size: var(--text-small);
		line-height: var(--leading-snug);
		color: var(--color-text-tertiary);
	}

	@media (min-width: 720px) {
		.trust-list {
			grid-template-columns: repeat(3, 1fr);
			gap: 0;
		}

		.trust-item + .trust-item {
			border-left: 1px solid var(--border-hairline);
			padding-left: var(--space-6);
			margin-left: var(--space-6);
		}
	}

	.card h3,
	.topline h3 {
		font-size: var(--text-h4);
	}

	/* Services — six cards, so a slightly tighter minimum than the default
	   lets three sit per row at desktop and two at tablet, rather than
	   stranding a fifth and sixth on a sparse third row. */
	.service-grid {
		--grid-min: 280px;
	}

	/* The stretched link below is positioned against the card, so the card has
	   to establish the containing block. .card doesn't set position itself —
	   it's a plain surface — so it's set here rather than pushed into the
	   shared class, where it would affect every card on the site. */
	.service-grid .card {
		position: relative;
	}

	.service-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		margin-bottom: var(--space-4);
		border-radius: var(--radius-md);
		/* Mixed from the card's own text colour rather than a surface token:
		   the card is a tint, and a neutral fill on a tint reads as a patch. */
		background: color-mix(in srgb, var(--color-text) 8%, transparent);
		color: var(--color-text);
	}

	/* Stretched link — the heading's anchor covers the whole card, so the
	   entire tile is clickable while the link's accessible name stays just
	   the service title. */
	.service-link {
		color: inherit;
		text-decoration: none;
	}

	.service-link::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.service-link:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	/* The card, not the text, is what visibly receives focus — otherwise the
	   ring draws around a heading inside a tile that is itself the target. */
	.service-grid .card:has(.service-link:focus-visible) {
		box-shadow: var(--focus-ring);
	}

	.service-link:focus-visible {
		outline: none;
	}

	/* Wide enough that three columns can't fit, so four items land as a
	   balanced 2x2 rather than a 3+1 orphan row. */
	.benefit-grid {
		--grid-min: 360px;
		gap: var(--space-6) var(--space-7);
	}

	/* Work preview */
	.work-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-4);
	}

	.work-figure {
		margin: 0;
	}

	.work-item {
		display: block;
	}

	.work-item img {
		transition: transform var(--duration-slow) var(--ease-out);
	}

	.work-item:hover img {
		transform: scale(1.03);
	}

	.work-caption {
		font-size: var(--text-small);
		margin: var(--space-3) 0 0;
	}

	@media (max-width: 640px) {
		.work-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 400px) {
		.work-grid {
			grid-template-columns: 1fr;
		}
	}

	/* Closing block */
	.closing-copy {
		max-width: var(--measure);
	}

	.closing-cta {
		margin-top: var(--space-6);
	}

	.closing-alt {
		margin-top: var(--space-5);
		margin-bottom: 0;
		font-size: var(--text-small);
	}

	.closing-card {
		padding: var(--space-7);
		align-self: start;
	}

	.closing-card-heading {
		font-size: var(--text-h4);
		margin-bottom: var(--space-4);
	}

	.contact-details {
		margin-bottom: var(--space-2);
		font-size: var(--text-large);
	}

	.contact-area {
		font-size: var(--text-small);
		margin-bottom: 0;
	}

	@media (max-width: 560px) {
		.closing-card {
			padding: var(--space-5);
		}
	}
</style>
