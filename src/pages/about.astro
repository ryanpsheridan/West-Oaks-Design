---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema, abs } from '../lib/schema';
import { SITE_TITLE, SERVICE_AREA_LABEL } from '../consts';

// ---------------------------------------------------------------------------
// PAGE CONTENT — everything a client edit touches lives in this block.
//
// Structure: intro → story → values → founder quote → CTA.
//
// ⚠️ FIRST DRAFT, AND THE MOST INVENTED PAGE ON THE SITE. The intake form
// said nothing about who runs this business or what they did before it, so
// the story below is a shape to fill in, not an account to keep.
//
// IMPORTANT: the business is new and has no completed projects. The stat
// band that used to sit here (years in business, projects completed, trees
// planted) has been removed rather than filled with plausible numbers. Do not
// put it back until there are real figures to put in it — and when there are,
// three honest numbers beat five impressive ones.
//
// Being new is not a weakness to write around. The page says so plainly and
// spends its space on the thing a new firm can actually offer: the experience
// its people bring, and a clear account of how they work.
// ---------------------------------------------------------------------------

const intro = {
	eyebrow: 'About us',
	heading: 'We build landscapes that outlast us',
	lead: `${SITE_TITLE} is a new design-build studio working across ${SERVICE_AREA_LABEL}. We draw the plan, build it with our own crews, and come back to look after it — a slower way to run a landscape company, and the only way we have found to be answerable for how a property looks in year ten rather than on handover day.`,
	image: {
		src: '/images/gallery/crew-on-site.svg',
		alt: 'Photo placeholder — three crew members walking a property beneath mature oaks',
	},
};

const story = {
	eyebrow: 'Our story',
	heading: 'Why we started this',
	// TODO: replace wholesale with the client's real account — what they did
	// before this, and what made them start. Keep it honest about being new;
	// a new firm that says so reads as more trustworthy than one that is
	// vague about how long it has been around.
	paragraphs: [
		`PLACEHOLDER STORY — replace with the founder's real background. What they did before ${SITE_TITLE}, and for how long. This is the page's load-bearing paragraph: with no completed projects to point at, the experience behind the business is the credential.`,
		'PLACEHOLDER STORY — replace with why they started it. The most convincing version of this is usually a specific frustration with how the work is normally done, not a mission statement. Concrete beginnings read as credible; "our passion for outdoor living" reads as filler.',
		`PLACEHOLDER STORY — replace with what they are building toward. ${SITE_TITLE} is new, and saying so directly is fine: what matters to someone deciding is who is doing the work and how, not how long the sign has been up.`,
	],
	image: {
		src: '/images/gallery/live-oak-canopy.svg',
		alt: 'Photo placeholder — a single mature live oak with a broad canopy spreading over open ground',
	},
};

const values = {
	eyebrow: 'What we stand for',
	heading: 'How we work',
	items: [
		{
			title: 'The site knows more than we do',
			description:
				'Every property already tells you where water wants to go, where shade already falls, and what grows without help. Designing starts with reading that, not with a style.',
			tint: '--tint-moss',
		},
		{
			title: 'Slow-growing things first',
			description:
				'A patio can be rebuilt in a week. A canopy oak cannot be rebuilt at all. When the two are in conflict, the tree wins and the hardscape moves.',
			tint: '--tint-sage',
		},
		{
			title: 'Sustainable has to mean measurable',
			description:
				'Native planting, drip conversion, rainwater capture, dark-sky lighting. We can tell you what each one saves in gallons or watts, because a claim you cannot measure is a marketing line.',
			tint: '--tint-fern',
		},
		{
			title: 'Answerable in year ten',
			description:
				'We would rather do fewer projects and keep looking after them. The crew that built your patio is the crew that comes back when a joint lifts, and they know why it was built that way.',
			tint: '--tint-sand',
		},
	],
};

// The owner's own words, not a client's. A client quote would be social
// proof this business has not earned yet; a founder stating what they are
// for is a position, which it can state on day one.
const quote = {
	// TODO: replace with a real line from the owner, in their own words.
	text: 'PLACEHOLDER — one sentence from the owner about what this business is for. Their own voice beats a paragraph in a copywriter’s.',
	name: 'Owner name',
	role: 'Founder',
};

const cta = {
	heading: 'Tell us what you are planning',
	lead: 'One form, a few minutes, and no obligation. It is how everything here starts.',
	primary: { label: 'Start your project', href: '/contact/#project' },
	secondary: { label: 'See how a project runs', href: '/process/' },
};

const trail = [{ name: 'About', path: '/about/' }];
const schema = [
	breadcrumbSchema(Astro.site, trail),
	{
		'@type': 'AboutPage',
		name: `About ${SITE_TITLE}`,
		description: intro.lead,
		url: abs(Astro.site, '/about/'),
	},
];
---

<BaseLayout
	title="About Us"
	description={`${SITE_TITLE} is a landscape design-build studio serving ${SERVICE_AREA_LABEL} — who we are, how long we have done this, and how we work.`}
	schema={schema}
>
	<section class="section-loose">
		<div class="container">
			<div class="split" style="--split-cols: 1.1fr 1fr;">
				<div class="intro-copy">
					<p class="eyebrow">{intro.eyebrow}</p>
					<h1>{intro.heading}</h1>
					<p class="lead">{intro.lead}</p>
				</div>
				<div class="media-frame" style="--media-ratio: 4 / 5;">
					<img src={intro.image.src} alt={intro.image.alt} fetchpriority="high" width="1600" height="1200" />
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="split split-reverse split-top">
				<div class="media-frame" style="--media-ratio: 4 / 3;">
					<img src={story.image.src} alt={story.image.alt} loading="lazy" width="1600" height="1200" />
				</div>
				<div class="story-copy">
					<p class="eyebrow">{story.eyebrow}</p>
					<h2>{story.heading}</h2>
					{story.paragraphs.map((text) => (
						<p class="text-secondary">{text}</p>
					))}
					<p class="text-secondary">
						What that looks like in practice is set out on the
						<a href="/process/">process page</a>, and the range of work we take on is
						on the <a href="/services/">services page</a>.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section section-sunken">
		<div class="container">
			<div class="section-header section-header-center">
				<div class="section-header-text">
					<p class="eyebrow">{values.eyebrow}</p>
					<h2>{values.heading}</h2>
				</div>
			</div>
			<ul class="grid-auto value-grid">
				{values.items.map((item) => (
					<li class="card card-tint" style={`--card-tint: var(${item.tint});`}>
						<h3>{item.title}</h3>
						<p class="text-secondary">{item.description}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section-loose section-brand">
		<div class="container">
			<blockquote class="quote quote-feature">
				<p>{quote.text}</p>
				<footer>
					<cite>{quote.name}</cite>, {quote.role}
				</footer>
			</blockquote>
		</div>
	</section>

	<section class="section cta-band">
		<div class="container">
			<div class="cta-inner">
				<h2>{cta.heading}</h2>
				<p class="cta-lead">{cta.lead}</p>
				<div class="cta-actions">
					<a href={cta.primary.href} class="btn btn-inverse btn-lg btn-arrow">{cta.primary.label}</a>
					<a href={cta.secondary.href} class="link-arrow cta-link">{cta.secondary.label}</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.intro-copy {
		max-width: var(--measure);
	}

	.story-copy {
		max-width: var(--measure);
	}

	.card h3 {
		font-size: var(--text-h4);
	}

	/* Four values land as a balanced 2x2 rather than a 3+1 orphan row. */
	.value-grid {
		--grid-min: 340px;
	}

	/* On the brand band the quote carries the whole section, so it loses the
	   left rule and centres — a 2px marker pinned to one side of a full-bleed
	   colour field reads as a stray mark rather than a quote. */
	.quote-feature {
		max-width: var(--measure-wide);
		margin-inline: auto;
		padding-left: 0;
		border-left: 0;
		text-align: center;
	}

	.quote-feature p {
		font-size: var(--text-h2);
		line-height: var(--leading-tight);
	}

	/* CTA band */
	.cta-inner {
		max-width: var(--measure);
	}

	.cta-lead {
		font-size: var(--text-large);
		margin-bottom: var(--space-6);
	}

	.cta-actions {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		flex-wrap: wrap;
	}

	.cta-link,
	.cta-link:hover {
		color: var(--color-ink-contrast);
	}
</style>
