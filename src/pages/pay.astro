---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbSchema } from '../lib/schema';
import { SITE_TITLE, SITE_PHONE, SITE_EMAIL, PAYMENT_URL } from '../consts';

// ---------------------------------------------------------------------------
// PAGE CONTENT — everything a client edit touches lives in this block.
//
// The intake form asked for payments: "Yes, probably a stripe integration.
// Will be super simple, can link out to payment." That is precisely the
// Stripe Payment Links case in CLAUDE.md's payments decision tree — a hosted
// checkout page the client sends people to, with no code and no card details
// ever touching this site or this developer's hands.
//
// It is a utility page, not a marketing one: nobody arrives here from search,
// they arrive because an invoice told them to. So it is noindex, kept out of
// the top nav, and linked only from the footer.
//
// ⚠️ FIRST DRAFT — PAYMENT_URL in consts.ts is a placeholder. The link below
// will 404 until the client creates the real Payment Link in their own Stripe
// account (their account, their money — see CLAUDE.md).
// ---------------------------------------------------------------------------

const intro = {
	eyebrow: 'Payments',
	heading: 'Make a payment',
	lead: `Pay an invoice or a deposit online. Payments are handled by Stripe on their own secure checkout page — ${SITE_TITLE} never sees or stores your card details.`,
};

const steps = [
	{
		icon: 'creditCard',
		title: 'Have your invoice number ready',
		description:
			'It is at the top of the invoice we emailed you. Entering it on the checkout page is what lets us match the payment to your project.',
	},
	{
		icon: 'shield',
		title: 'Pay on Stripe’s secure page',
		description:
			'The button below opens Stripe’s own hosted checkout. Card, Apple Pay and Google Pay all work. Nothing about your card touches this website.',
	},
	{
		icon: 'mail',
		title: 'Keep the receipt',
		description:
			'Stripe emails you a receipt as soon as the payment clears. We see it on our side within a few minutes and will confirm if anything looks off.',
	},
];

const trail = [{ name: 'Make a payment', path: '/pay/' }];
const schema = [breadcrumbSchema(Astro.site, trail)];
---

<BaseLayout
	title="Make a Payment"
	description={`Pay an invoice or deposit for your ${SITE_TITLE} project securely through Stripe.`}
	schema={schema}
	noindex
>
	<section class="section">
		<div class="container container-narrow">
			<p class="eyebrow">{intro.eyebrow}</p>
			<h1>{intro.heading}</h1>
			<p class="lead">{intro.lead}</p>

			<div class="card pay-card">
				<span class="pay-icon"><Icon name="creditCard" size={28} /></span>
				<h2 class="pay-heading">Pay an invoice</h2>
				<p class="text-secondary pay-note">
					Opens Stripe’s secure checkout in a new tab. You will need your invoice number.
				</p>
				<a
					href={PAYMENT_URL}
					class="btn btn-brand btn-lg btn-arrow"
					target="_blank"
					rel="noopener noreferrer"
				>
					Pay with Stripe
				</a>
				{/* Opening in a new tab is announced rather than left as a
				    surprise — a link that silently moves you to another site is
				    a WCAG 3.2.5 problem and, on a payment link, a trust one. */}
				<p class="visually-hidden">Opens in a new tab on stripe.com</p>
				<p class="pay-newtab text-tertiary">Opens in a new tab</p>
			</div>

			<h2 class="steps-heading">How it works</h2>
			<ol class="pay-steps">
				{steps.map((step, i) => (
					<li class="pay-step">
						<span class="pay-step-icon" aria-hidden="true"><Icon name={step.icon} size={20} /></span>
						<div>
							<h3>{step.title}</h3>
							<p class="text-secondary">{step.description}</p>
						</div>
					</li>
				))}
			</ol>

			<div class="card card-tint pay-help">
				<h2 class="help-heading">Something not right?</h2>
				<p>
					If the amount looks wrong, the invoice number will not go through, or you would
					rather pay by check or bank transfer, get in touch before paying — do not guess.
				</p>
				<p class="help-contact">
					<a href={`tel:${SITE_PHONE.replace(/[^\d+]/g, '')}`}>{SITE_PHONE}</a>
					<br />
					<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
				</p>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.pay-card {
		margin: var(--space-7) 0;
		padding: var(--space-7);
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.pay-icon {
		display: grid;
		place-items: center;
		width: 3.5rem;
		height: 3.5rem;
		margin-bottom: var(--space-4);
		border-radius: var(--radius-lg);
		background: var(--surface-fill);
		color: var(--color-text);
	}

	.pay-heading {
		font-size: var(--text-h3);
	}

	.pay-note {
		max-width: 34ch;
		margin-bottom: var(--space-6);
	}

	.pay-newtab {
		font-size: var(--text-small);
		margin: var(--space-4) 0 0;
	}

	.steps-heading {
		font-size: var(--text-h3);
		margin-bottom: var(--space-5);
	}

	.pay-steps {
		list-style: none;
		margin: 0 0 var(--space-8);
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.pay-step {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-4);
		align-items: start;
	}

	.pay-step-icon {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: var(--radius-md);
		background: var(--surface-fill);
		color: var(--color-text);
	}

	.pay-step h3 {
		font-size: var(--text-h5);
		margin-bottom: var(--space-2);
	}

	.pay-step p {
		margin-bottom: 0;
	}

	.pay-help {
		padding: var(--space-6);
	}

	.help-heading {
		font-size: var(--text-h4);
	}

	.help-contact {
		margin-bottom: 0;
		font-size: var(--text-large);
	}
</style>
