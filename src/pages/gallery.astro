---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbSchema, abs } from '../lib/schema';
import { SITE_TITLE, SERVICE_AREA_LABEL, BOOKING_URL } from '../consts';

// ---------------------------------------------------------------------------
// PAGE CONTENT — everything a client edit touches lives in this block.
//
// The starter shipped this page as a menu of three layouts (grid, carousel,
// masonry) to pick from per client. Picked: the captioned grid, which is what
// all three reference sites use for a project index, and which is the only
// one of the three that works when the client has 40 photos instead of 6.
// The carousel and masonry are deleted rather than left in place — see
// CLAUDE.md, "Gallery / Photo Uploads".
//
// `alt` describes the image for anyone who can't see it; `caption` is shown
// on screen. They do different jobs, so both are written rather than one
// being duplicated into the other.
//
// ⚠️ FIRST DRAFT — every image below is a grey placeholder box and every
// location is invented. Replace both with real project photography as it
// arrives: drop the photo in at the same path, delete the "Photo placeholder
// —" prefix from its alt text, and the rest needs no edit. File naming
// convention: descriptive slug, never IMG_4821.jpg.
// ---------------------------------------------------------------------------

// Categories double as the filter control and as the grouping a visitor
// scans by. Keep them aligned with the service lines in src/data/services.ts
// so a visitor moving between the two pages sees the same vocabulary.
const categories = [
	{ id: 'all', label: 'All work' },
	{ id: 'hardscape', label: 'Patios & structures' },
	{ id: 'planting', label: 'Planting & trees' },
	{ id: 'water', label: 'Water & irrigation' },
	{ id: 'lighting', label: 'Lighting' },
];

const images = [
	{
		src: '/images/gallery/limestone-terrace.svg',
		category: 'hardscape',
		alt: 'Photo placeholder — a limestone terrace stepping down toward a lawn beneath two mature oaks',
		caption: 'Limestone terrace stepping down to the lawn',
		location: 'Dripping Springs',
	},
	{
		src: '/images/gallery/pergola-shade-structure.svg',
		category: 'hardscape',
		alt: 'Photo placeholder — a cedar pergola with evenly spaced rafters over a paved seating area',
		caption: 'Cedar pergola over a west-facing patio',
		location: 'Wimberley',
	},
	{
		src: '/images/gallery/dry-stack-retaining-wall.svg',
		category: 'hardscape',
		alt: 'Photo placeholder — a dry-stacked limestone retaining wall holding a planted slope',
		caption: 'Dry-stacked limestone wall holding a slope',
		location: 'West Austin',
	},
	{
		src: '/images/gallery/live-oak-canopy.svg',
		category: 'planting',
		alt: 'Photo placeholder — a single mature live oak with a broad canopy spreading over open ground',
		caption: 'Heritage live oak, pruned for structure',
		location: 'Driftwood',
	},
	{
		src: '/images/gallery/oak-motte-meadow.svg',
		category: 'planting',
		alt: 'Photo placeholder — a motte of live oaks standing over an open meadow, with low hills behind',
		caption: 'Oak motte and restored meadow',
		location: 'Kyle',
	},
	{
		src: '/images/gallery/native-planting-beds.svg',
		category: 'planting',
		alt: 'Photo placeholder — massed native planting flanking a stone path running away from the viewer',
		caption: 'Native beds flanking the approach path',
		location: 'Buda',
	},
	{
		src: '/images/gallery/maintenance-visit.svg',
		category: 'planting',
		alt: 'Photo placeholder — established planting under a mature canopy during a seasonal maintenance visit',
		caption: 'Seasonal visit on a stewardship plan',
		location: 'San Marcos',
	},
	{
		src: '/images/gallery/irrigation-zone.svg',
		category: 'water',
		alt: 'Photo placeholder — an irrigation zone spraying in arcs across a planted field',
		caption: 'Rezoned irrigation on a smart controller',
		location: 'Buda',
	},
	{
		src: '/images/gallery/evening-path-lighting.svg',
		category: 'lighting',
		alt: 'Photo placeholder — shielded path lights casting pools of light along a paved route at dusk',
		caption: 'Low-voltage path lighting at dusk',
		location: 'West Austin',
	},
	{
		src: '/images/gallery/site-plan-drawing.svg',
		category: 'planting',
		alt: 'Photo placeholder — a hand-drafted site plan over a measured grid, showing a building footprint, a path and three tree canopies',
		caption: 'Master plan, built in three phases',
		location: 'Dripping Springs',
	},
	{
		src: '/images/gallery/crew-on-site.svg',
		category: 'hardscape',
		alt: 'Photo placeholder — three crew members walking a property beneath mature oaks during a site visit',
		caption: 'Walking a property before design begins',
		location: 'Wimberley',
	},
];

const cta = {
	heading: 'Your property is the next one',
	lead: 'An hour on site is how every project here starts. No charge, no drawings yet.',
	primary: { label: 'Book a site visit', href: BOOKING_URL },
	secondary: { label: 'See how a project runs', href: '/process/' },
};

const trail = [{ name: 'Gallery', path: '/gallery/' }];
const schema = [
	breadcrumbSchema(Astro.site, trail),
	// An ImageGallery with each photo as an ImageObject. Captions are marked
	// up rather than left as loose text, which is what lets an image result
	// carry the project description instead of just the filename.
	{
		'@type': 'ImageGallery',
		name: `${SITE_TITLE} project gallery`,
		description: `Landscape design and build projects across ${SERVICE_AREA_LABEL}.`,
		url: abs(Astro.site, '/gallery/'),
		image: images.map((image) => ({
			'@type': 'ImageObject',
			contentUrl: abs(Astro.site, image.src),
			caption: `${image.caption} — ${image.location}`,
			description: image.alt,
			creditText: SITE_TITLE,
		})),
	},
];
---

<BaseLayout
	title="Project Gallery"
	description={`Landscape design-build projects across ${SERVICE_AREA_LABEL}: limestone terraces, cedar pergolas, native planting and outdoor lighting.`}
	schema={schema}
>
	<section class="section-hero">
		<div class="container">
			<div class="page-hero">
				<h1>Project gallery</h1>
				<p class="lead">
					Recent work across {SERVICE_AREA_LABEL}. Each of these started with the same
					question: what is already good here, and what is in its way?
				</p>
				<p class="draft-note">
					<strong>Draft note for the client:</strong> every grey box below is holding space
					for one of your photos. The caption under each says which photo goes there.
					Send them over and we will swap them in.
				</p>
			</div>
		</div>
	</section>

	<section class="section-tight">
		<div class="container">
			{/*
				Filter controls. Progressive enhancement: without JS the buttons
				do nothing and every project stays visible, which is the correct
				fallback for a filter — never the empty state.

				Buttons rather than links, because this changes what is shown on
				this page rather than navigating anywhere. aria-pressed carries
				the selected state, so it isn't left to colour alone.
			*/}
			<div class="filter-bar" role="group" aria-label="Filter projects by type">
				{categories.map((category, i) => (
					<button
						type="button"
						class:list={['filter-btn', { active: i === 0 }]}
						data-filter={category.id}
						aria-pressed={i === 0 ? 'true' : 'false'}
					>
						{category.label}
					</button>
				))}
			</div>

			<p class="visually-hidden" role="status" aria-live="polite" id="filter-status"></p>

			<ul class="photo-grid" id="photo-grid">
				{images.map((image, i) => (
					<li class="photo-item" data-category={image.category}>
						<figure class="photo-figure">
							<button
								type="button"
								class="gallery-trigger media-frame"
								data-index={i}
								aria-label={`Open full size: ${image.caption}, ${image.location}`}
							>
								<img src={image.src} alt={image.alt} loading="lazy" width="1600" height="1200" />
								<span class="photo-expand" aria-hidden="true"><Icon name="expand" size={16} /></span>
							</button>
							<figcaption class="photo-caption">
								<span class="photo-title">{image.caption}</span>
								<span class="photo-location text-tertiary">{image.location}</span>
							</figcaption>
						</figure>
					</li>
				))}
			</ul>

			{/* Shown only when a filter matches nothing, which the current set
			    can't produce — but a client adding categories later can. */}
			<p class="empty-state" id="empty-state" hidden>
				No projects in that category yet. <button type="button" class="link-button" data-filter="all">Show all work</button>.
			</p>
		</div>
	</section>

	<section class="section cta-band">
		<div class="container">
			<div class="cta-inner">
				<h2>{cta.heading}</h2>
				<p class="cta-lead">{cta.lead}</p>
				<div class="cta-actions">
					<a href={cta.primary.href} class="btn btn-inverse btn-lg btn-arrow">{cta.primary.label}</a>
					<a href={cta.secondary.href} class="link-arrow cta-link">{cta.secondary.label}</a>
				</div>
			</div>
		</div>
	</section>

	<dialog id="lightbox" class="lightbox" aria-label="Photo preview">
		<div class="lightbox-inner">
			{/*
				No `src` attribute at all, rather than src="". An empty src
				resolves against the current document, so the browser fires a
				second request for the page itself on every load of this page —
				for an image that is inside a closed <dialog> and never shown.
				Omitting the attribute makes no request; the script sets both
				src and alt before the dialog is ever opened.
			*/}
			<img id="lightbox-img" alt="" />
			<p class="lightbox-caption" id="lightbox-caption"></p>
		</div>
		<button type="button" id="lightbox-prev" class="lightbox-nav lightbox-prev" aria-label="Previous photo">
			<Icon name="arrowLeft" size={20} />
		</button>
		<button type="button" id="lightbox-next" class="lightbox-nav lightbox-next" aria-label="Next photo">
			<Icon name="arrowRight" size={20} />
		</button>
		<button type="button" id="lightbox-close" class="lightbox-close" aria-label="Close">&times;</button>
	</dialog>

	<script type="application/json" id="gallery-data" set:html={JSON.stringify(images)} />
</BaseLayout>

<script>
	type GalleryImage = {
		src: string;
		category: string;
		alt: string;
		caption: string;
		location: string;
	};

	const data: GalleryImage[] = JSON.parse(
		document.getElementById('gallery-data')?.textContent || '[]'
	);

	const dialog = document.getElementById('lightbox') as HTMLDialogElement;
	const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
	const lightboxCaption = document.getElementById('lightbox-caption') as HTMLParagraphElement;
	const grid = document.getElementById('photo-grid');
	const emptyState = document.getElementById('empty-state');
	const filterStatus = document.getElementById('filter-status');

	let lastTrigger: HTMLElement | null = null;

	// The lightbox steps through whatever is currently *visible*, not through
	// the full set. Arrowing from a filtered view into a hidden photo would
	// show something the visitor has explicitly filtered out.
	let visible: number[] = data.map((_, i) => i);
	let cursor = 0;

	// ---- Filtering ---------------------------------------------------------

	function applyFilter(filter: string) {
		const items = grid?.querySelectorAll<HTMLLIElement>('.photo-item') ?? [];
		const next: number[] = [];

		items.forEach((item, i) => {
			const match = filter === 'all' || item.dataset.category === filter;
			item.hidden = !match;
			if (match) next.push(i);
		});

		visible = next;

		document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach((btn) => {
			const on = btn.dataset.filter === filter;
			btn.classList.toggle('active', on);
			btn.setAttribute('aria-pressed', on ? 'true' : 'false');
		});

		if (emptyState) emptyState.hidden = next.length > 0;

		// Announced, because the only other signal that the filter did
		// anything is photos silently disappearing off-screen.
		if (filterStatus) {
			const label =
				filter === 'all'
					? 'all projects'
					: document.querySelector(`.filter-btn[data-filter="${filter}"]`)?.textContent?.trim().toLowerCase();
			filterStatus.textContent = `Showing ${next.length} ${next.length === 1 ? 'project' : 'projects'} in ${label}.`;
		}
	}

	// ---- Lightbox ----------------------------------------------------------

	const wrap = (i: number) => (i + visible.length) % visible.length;

	function setLightbox(position: number) {
		if (!visible.length) return;
		cursor = wrap(position);
		const image = data[visible[cursor]];
		lightboxImg.src = image.src;
		lightboxImg.alt = image.alt;
		lightboxCaption.textContent = `${cursor + 1} / ${visible.length} — ${image.caption}, ${image.location}`;
	}

	function openLightbox(index: number, trigger: HTMLElement) {
		const position = visible.indexOf(index);
		if (position === -1) return;
		lastTrigger = trigger;
		setLightbox(position);
		dialog.showModal();
	}

	// Returning focus to whatever opened the dialog — without this, closing it
	// drops focus back to <body> and a keyboard user restarts at the top.
	dialog.addEventListener('close', () => lastTrigger?.focus());

	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;

		const filterBtn = target.closest<HTMLButtonElement>('[data-filter]');
		if (filterBtn) return applyFilter(filterBtn.dataset.filter || 'all');

		if (target.closest('#lightbox-prev')) return setLightbox(cursor - 1);
		if (target.closest('#lightbox-next')) return setLightbox(cursor + 1);
		if (target.closest('#lightbox-close')) return dialog.close();
		// Clicking the backdrop closes; clicking the image itself must not.
		if (target === dialog) return dialog.close();

		const trigger = target.closest<HTMLElement>('.gallery-trigger');
		if (trigger) openLightbox(Number(trigger.dataset.index || 0), trigger);
	});

	document.addEventListener('keydown', (e) => {
		if (!dialog.open) return;
		if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
		e.preventDefault();
		setLightbox(cursor + (e.key === 'ArrowLeft' ? -1 : 1));
	});
</script>

<style>
	.page-hero {
		max-width: var(--measure-wide);
	}

	/* Temporary. Delete this block, and the <p> that uses it, once real
	   photography replaces the placeholder illustrations. */
	.draft-note {
		margin-top: var(--space-5);
		padding: var(--space-4);
		border-radius: var(--radius-md);
		background: var(--color-accent-caution-bg);
		border: 1px solid var(--color-accent-caution);
		font-size: var(--text-small);
		color: var(--color-text);
		max-width: var(--measure);
	}

	/* Filter bar — pills that read as a set of options rather than as
	   buttons. Scrolls horizontally on narrow screens instead of wrapping
	   into a two-row block that pushes the grid down the page. */
	.filter-bar {
		display: flex;
		gap: var(--space-2);
		margin-bottom: var(--space-6);
		overflow-x: auto;
		padding-bottom: var(--space-2);
		scrollbar-width: thin;
	}

	.filter-btn {
		flex-shrink: 0;
		padding: var(--space-2) var(--space-4);
		border: 1px solid var(--border-default);
		border-radius: var(--radius-pill);
		background: var(--surface-raised);
		color: var(--color-text-secondary);
		font-family: inherit;
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		letter-spacing: var(--tracking-snug);
		cursor: pointer;
		transition:
			background-color var(--duration-fast) var(--ease-out),
			border-color var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out);
	}

	.filter-btn:hover {
		border-color: var(--border-strong);
		color: var(--color-text);
	}

	/* Selected state carries weight and fill, not colour alone — and
	   aria-pressed carries it for anyone not seeing either. */
	.filter-btn.active {
		background: var(--color-ink);
		border-color: var(--color-ink);
		color: var(--color-ink-contrast);
	}

	/* Grid */
	.photo-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-6) var(--space-4);
	}

	.photo-item[hidden] {
		display: none;
	}

	.photo-figure {
		margin: 0;
	}

	/* Every clickable photo is a plain button so it's keyboard-focusable and
	   announced correctly, with none of the default button chrome. */
	.gallery-trigger {
		position: relative;
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.gallery-trigger img {
		transition: transform var(--duration-slow) var(--ease-out);
	}

	.gallery-trigger:hover img {
		transform: scale(1.03);
	}

	/* Expand affordance, revealed on hover and whenever the trigger is
	   focused — otherwise a keyboard user gets no hint the photo opens. */
	.photo-expand {
		position: absolute;
		top: var(--space-3);
		right: var(--space-3);
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: var(--radius-sm);
		background: var(--overlay-chip);
		color: var(--color-text);
		opacity: 0;
		transition: opacity var(--duration-base) var(--ease-out);
	}

	.gallery-trigger:hover .photo-expand,
	.gallery-trigger:focus-visible .photo-expand {
		opacity: 1;
	}

	@media (hover: none) {
		.photo-expand {
			opacity: 1;
		}
	}

	.photo-caption {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		margin-top: var(--space-3);
	}

	.photo-title {
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		color: var(--color-text);
		line-height: var(--leading-snug);
	}

	.photo-location {
		font-size: var(--text-small);
	}

	@media (max-width: 720px) {
		.photo-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 420px) {
		.photo-grid {
			grid-template-columns: 1fr;
		}
	}

	.empty-state {
		padding: var(--space-8) 0;
		text-align: center;
		color: var(--color-text-secondary);
	}

	.link-button {
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		color: var(--color-accent);
		text-decoration: underline;
		cursor: pointer;
	}

	/* CTA band */
	.cta-inner {
		max-width: var(--measure);
	}

	.cta-lead {
		font-size: var(--text-large);
		margin-bottom: var(--space-6);
	}

	.cta-actions {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		flex-wrap: wrap;
	}

	.cta-link,
	.cta-link:hover {
		color: var(--color-ink-contrast);
	}

	/* --- Lightbox ---------------------------------------------------------
	   Visual/positioning rules only apply while [open], so a closed <dialog>
	   keeps the UA default display:none instead of sitting invisibly on top
	   of the page and eating clicks. */
	.lightbox {
		margin: 0;
		padding: var(--space-7);
		border: none;
		background: transparent;
		max-width: none;
		max-height: none;
	}

	.lightbox[open] {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.lightbox::backdrop {
		background: var(--overlay-scrim);
	}

	.lightbox-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-4);
		max-height: 100%;
		min-width: 0;
	}

	.lightbox img {
		max-width: 100%;
		min-height: 0;
		object-fit: contain;
		border-radius: var(--radius-md);
	}

	.lightbox-caption {
		margin: 0;
		font-size: var(--text-small);
		color: var(--color-ink-contrast-muted);
		text-align: center;
		font-variant-numeric: tabular-nums;
	}

	.lightbox-nav,
	.lightbox-close {
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
		border: none;
		border-radius: 50%;
		background: var(--overlay-chip);
		color: var(--color-text);
		cursor: pointer;
		box-shadow: var(--shadow-sm);
		-webkit-tap-highlight-color: transparent;
		transition: background-color var(--duration-fast) var(--ease-out);
	}

	.lightbox-nav:hover,
	.lightbox-close:hover {
		background: var(--surface-page);
	}

	.lightbox-nav {
		top: 50%;
		transform: translateY(-50%);
		width: 2.75rem;
		height: 2.75rem;
	}

	.lightbox-prev {
		left: var(--space-5);
	}

	.lightbox-next {
		right: var(--space-5);
	}

	.lightbox-close {
		top: var(--space-5);
		right: var(--space-5);
		width: 2.5rem;
		height: 2.5rem;
		font-size: var(--text-h3);
		line-height: 1;
	}

	@media (max-width: 640px) {
		.lightbox {
			padding: var(--space-4);
		}

		.lightbox-prev {
			left: var(--space-2);
		}

		.lightbox-next {
			right: var(--space-2);
		}

		.lightbox-close {
			top: var(--space-2);
			right: var(--space-2);
		}
	}
</style>
